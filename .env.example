# Copy to .env and fill in from Firebase Console → Project settings → Your apps.
#
# These are read by firebaseConfig.js and INLINED INTO THE BUNDLE AT BUILD TIME.
# That has two consequences worth knowing:
#
#   1. A build environment without them ships an app whose Firebase config is
#      `undefined`, and `getDatabase()` throws at module scope — a crash on
#      launch, before the board ever renders. `.env` is gitignored, so an EAS
#      build needs these set as EAS environment variables:
#
#        npx eas env:create --scope project --name EXPO_PUBLIC_FIREBASE_API_KEY --value "..." --environment production
#        (repeat for each key below, then `npx eas env:list`)
#
#   2. They are not secrets in the security sense — anything inlined into a
#      client bundle is readable by anyone with the APK. What protects the data
#      is database.rules.json and storage.rules, not the obscurity of these
#      values. Do not let that make you casual: EXPO_PUBLIC_GOOGLE_CLOUD_VISION_API_KEY
#      below IS billable and IS worth restricting (Google Cloud Console → APIs &
#      Services → Credentials → Application restrictions).

EXPO_PUBLIC_FIREBASE_API_KEY=your-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.europe-west1.firebasedatabase.app
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:android:0000000000000000000000

# Optional. Only needed if the client calls Cloud Vision directly rather than
# going through the imageCaptionProxy / ocrToAACPhrases Cloud Functions.
EXPO_PUBLIC_GOOGLE_CLOUD_VISION_API_KEY=your-vision-api-key
